POSTGRES_DB=learnbridge
POSTGRES_USER=learnbridge
POSTGRES_PASSWORD=replace_with_your_existing_database_password

IMAGE_TAG=v8.0.8
APP_ORIGIN=https://learnbridge-app.com
CORS_ORIGIN=https://learnbridge-app.com

AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=replace_with_your_azure_key
AZURE_OPENAI_DEPLOYMENT=your_exact_deployment_name
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

SUPPORT_EMAIL=support@learnbridge-app.com
SMTP_HOST=smtp.your-email-provider.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=no-reply@learnbridge-app.com
SMTP_PASSWORD=replace_with_your_smtp_password_or_app_password
SMTP_FROM="LearnBridge <no-reply@learnbridge-app.com>"
SMTP_REPLY_TO=support@learnbridge-app.com
TERMS_URL=https://learnbridge-app.com/terms
PRIVACY_URL=https://learnbridge-app.com/privacy
REFUND_POLICY_URL=https://learnbridge-app.com/refunds
TERMS_VERSION=2026-11-02
SUPER_ADMIN_NAME=LearnBridge Administrator
SUPER_ADMIN_EMAIL=admin@learnbridge-app.com
SUPER_ADMIN_PASSWORD=replace_with_a_unique_password_of_at_least_12_characters

# Start with sk_test_... and change to sk_live_... only after a successful test payment.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_INDIVIDUAL_MONTHLY_PLAN=PLN_replace_me
PAYSTACK_INDIVIDUAL_ANNUAL_PLAN=PLN_replace_me
PAYSTACK_FAMILY_MONTHLY_PLAN=PLN_replace_me
PAYSTACK_FAMILY_ANNUAL_PLAN=PLN_replace_me

# Generate with: openssl rand -hex 32
PRELOAD_TOKEN=replace_with_a_long_random_token
