POSTGRES_DB=learnbridge
POSTGRES_USER=learnbridge
POSTGRES_PASSWORD=replace_with_a_strong_password
WEB_PORT=8080
IMAGE_TAG=v8.0.8
APP_ORIGIN=http://localhost:8080
CORS_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
SUPPORT_EMAIL=support@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="LearnBridge <no-reply@example.com>"
SMTP_REPLY_TO=support@example.com
TERMS_URL=
PRIVACY_URL=
REFUND_POLICY_URL=
TERMS_VERSION=test-draft

# Created once when no platform administrator exists. Use at least 12 characters.
SUPER_ADMIN_NAME=LearnBridge Administrator
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace_with_a_long_unique_password

# Use a Paystack test secret key until the complete payment flow has been tested.
# The secret key belongs only in this server-side file; never add it to src/.
PAYSTACK_SECRET_KEY=sk_test_replace_me

# Create these four recurring plans in the same Paystack test/live mode as the
# secret key. Monthly plans must use interval "monthly" and annual plans must
# use interval "annually". Copy each PLN_... code exactly.
PAYSTACK_INDIVIDUAL_MONTHLY_PLAN=PLN_replace_me
PAYSTACK_INDIVIDUAL_ANNUAL_PLAN=PLN_replace_me
PAYSTACK_FAMILY_MONTHLY_PLAN=PLN_replace_me
PAYSTACK_FAMILY_ANNUAL_PLAN=PLN_replace_me

# Protects the saved-content inventory used by preload and illustration scripts.
PRELOAD_TOKEN=replace_with_a_long_random_token

# Optional. Saved content works without this. New topic plans and lesson notes need it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Azure OpenAI alternative. When AZURE_OPENAI_ENDPOINT is set, Azure is used.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
