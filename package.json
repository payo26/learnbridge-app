{
  "name": "learnbridge-dual-curriculum",
  "private": true,
  "version": "8.0.12",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:maps": "node scripts/generate-map-data.mjs",
    "build": "node scripts/clean-dist.mjs && npm run generate:maps && vite build && node scripts/generate-seo-pages.mjs",
    "test": "npm --prefix backend ci --omit=dev && npm run validate:curricula && npm run validate:seo && node --test tests/*.test.mjs",
    "validate:curricula": "node scripts/validate-curricula.mjs",
    "validate:seo": "node scripts/validate-seo.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "preload": "node scripts/preload-content.mjs",
    "preload:british-core": "node scripts/preload-content.mjs --preset british-core",
    "preload:british-samples": "node scripts/preload-content.mjs --preset british-samples",
    "audit-diagrams": "node scripts/audit-diagram-coverage.mjs",
    "audit-diagram-relevance": "node backend/repair-diagram-contamination.mjs",
    "repair-diagram-relevance": "node backend/repair-diagram-contamination.mjs --apply",
    "backfill-diagrams": "node scripts/backfill-diagrams.mjs",
    "backfill-illustrations": "node scripts/backfill-diagrams.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@svg-maps/nigeria": "^2.0.0",
    "@svg-maps/world": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "svg-path-bounds": "^1.0.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
